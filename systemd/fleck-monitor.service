[Unit]
Description=Monitor Temporal Termo Fleck Nilo 150 (Tapo P110)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=albertvilla
WorkingDirectory=/home/albertvilla/monitor_congelador
ExecStartPre=/bin/mkdir -p /home/albertvilla/monitor_congelador/data
ExecStart=/home/albertvilla/monitor_congelador/venv/bin/python -m src.collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
